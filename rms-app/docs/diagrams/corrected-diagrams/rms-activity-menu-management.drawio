<mxfile host="app.diagrams.net" agent="Mozilla/5.0">
  <diagram id="rms-act-menu" name="Activity Diagram - Menu Management">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1350" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Figure 4.1.1: Activity Diagram for Menu &amp;amp; Recipe Ingredient Management Process&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="175" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Initial Node -->
        <mxCell id="init" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="455" y="70" width="26" height="26" as="geometry" />
        </mxCell>

        <!-- Action 1 -->
        <mxCell id="act_login" value="Admin Logs in &amp;amp; Navigates to Menu Management" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="325" y="130" width="285" height="45" as="geometry" />
        </mxCell>

        <!-- Action 2 -->
        <mxCell id="act_select" value="Select 'Add New Menu Item' or 'Edit Existing Item'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="325" y="210" width="285" height="45" as="geometry" />
        </mxCell>

        <!-- Action 3 -->
        <mxCell id="act_details" value="Enter Name, Category, Price, Description &amp;amp; Image" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="325" y="290" width="285" height="45" as="geometry" />
        </mxCell>

        <!-- Action 4 -->
        <mxCell id="act_recipe" value="Configure Recipe: Link Inventory Items&lt;br&gt;&amp;amp; Specify 'Quantity Required per Dish'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="325" y="370" width="285" height="48" as="geometry" />
        </mxCell>

        <!-- Action 5: Submit -->
        <mxCell id="act_submit" value="Submit Form &amp;amp; Trigger Validation" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="325" y="455" width="285" height="45" as="geometry" />
        </mxCell>

        <!-- Decision 1: Validation -->
        <mxCell id="dec_valid" value="Validation&lt;br&gt;Passed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="405" y="535" width="125" height="65" as="geometry" />
        </mxCell>

        <!-- Validation Error (Spacious right placement) -->
        <mxCell id="act_error" value="Display Validation Errors&lt;br&gt;&amp;amp; Highlight Invalid Fields" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="660" y="543.5" width="190" height="48" as="geometry" />
        </mxCell>

        <!-- Action 6: Save DB -->
        <mxCell id="act_save" value="Save Dish in 'menus' Table &amp;amp;&lt;br&gt;Sync Ingredients in 'menu_ingredients' Table" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="315" y="640" width="305" height="48" as="geometry" />
        </mxCell>

        <!-- Action 7: Cache & Website -->
        <mxCell id="act_cache" value="Refresh Digital Menu Cache &amp;amp; Update Public Website" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="315" y="725" width="305" height="45" as="geometry" />
        </mxCell>

        <!-- Action 8: Confirmation -->
        <mxCell id="act_confirm" value="Display 'Menu Item &amp;amp; Recipe Saved Successfully'" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="315" y="805" width="305" height="45" as="geometry" />
        </mxCell>

        <!-- Final Node -->
        <mxCell id="final_node" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="453" y="885" width="28" height="28" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="init" target="act_login" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_login" target="act_select" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_select" target="act_details" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_details" target="act_recipe" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_recipe" target="act_submit" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_submit" target="dec_valid" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- [No] -> Error -> Retry (routed with clear clearance on far right x=880) -->
        <mxCell id="e_no" value="[No]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="dec_valid" target="act_error" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1;dashed=1;" edge="1" source="act_error" target="act_details" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="568" /><mxPoint x="880" y="312.5" /></Array></mxGeometry>
        </mxCell>

        <!-- [Yes] -> Save -->
        <mxCell id="e_yes" value="[Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" edge="1" source="dec_valid" target="act_save" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_save" target="act_cache" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_cache" target="act_confirm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.2;" edge="1" source="act_confirm" target="final_node" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>